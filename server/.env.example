# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Groq API key (Jobs A/B/C — server/src/services/ai/). Required.
GROQ_API_KEY=your_groq_api_key_here

# Firebase Admin service-account JSON, base64-encoded (serverless has no filesystem for a key
# file, so the whole JSON travels in one env var). Required.
# Generate: base64 -w0 serviceAccountKey.json   (macOS: base64 -i serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_B64=your_base64_encoded_service_account_json_here

# Local dev server port. Optional — defaults to 3001 if unset.
PORT=3001
