rules_version = '2';

// Celer Sanitas — client is READ-ONLY; all writes go through the server Admin SDK (which bypasses
// these rules). No real PII is stored, only synthetic intake Q&A (Rules.md §1).
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{id} {
      allow read: if true;    // doctor dashboard reads (Day 6) — demo data only
      allow write: if false;  // NEVER from the client SDK — server Admin SDK writes these
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
